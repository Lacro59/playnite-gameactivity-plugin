<UserControl x:Class="GameActivity.Controls.AggregateSourcesChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:livechartscommon="clr-namespace:CommonPluginsControls.LiveChartsCommon"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="800">

    <!-- Sources aggregate: total + day + week (fixed layout). -->
    <Grid x:Name="PART_SourcesChartsGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width=".7*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="PART_TotalHoursCard" Grid.Row="0" Grid.Column="1" Style="{DynamicResource CardBorder}" Padding="8" Margin="10,0,0,0">
            <Grid x:Name="gridMonth">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0.55*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="PART_ChartTotal_Label"
                           Style="{DynamicResource SectionHeaderText}"
                           Text="{DynamicResource LOCGameActivityTotalHoursBySources}"
                           HorizontalAlignment="Center"
                           Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />

                <lvc:CartesianChart x:Name="PART_ChartTotal" LegendLocation="None"
                                    Grid.Row="1" Grid.Column="0"
                                    DisableAnimations="True" AnimationsSpeed="10"
                                    FontFamily="{DynamicResource CommonFont}">
                    <lvc:CartesianChart.DataTooltip>
                        <livechartscommon:CustomerToolTipForTime x:Name="PART_ChartTotal_ToolTip" />
                    </lvc:CartesianChart.DataTooltip>
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis x:Name="PART_ChartTotal_X" ShowLabels="True"
                                  FontSize="{DynamicResource FontSize}" FontFamily="{DynamicResource CommonFont}">
                            <lvc:Axis.Separator>
                                <lvc:Separator Step="1" />
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis x:Name="PART_ChartTotal_Y"
                                  FontSize="{DynamicResource FontSize}" FontFamily="{DynamicResource FontFamily}" />
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>

                <lvc:PieChart x:Name="PART_ChartTotalPie" LegendLocation="None"
                              Grid.Row="1" Grid.Column="1"
                              DisableAnimations="True" AnimationsSpeed="10"
                              Margin="8,0,0,0"
                              FontFamily="{DynamicResource CommonFont}">
                    <lvc:PieChart.DataTooltip>
                        <livechartscommon:CustomerToolTipForTime x:Name="PART_ChartTotalPie_ToolTip" />
                    </lvc:PieChart.DataTooltip>
                </lvc:PieChart>
            </Grid>
        </Border>

        <Border x:Name="PART_HoursByDayCard" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Style="{DynamicResource CardBorder}" Padding="8" Margin="0">
            <Grid x:Name="GridDay">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="PART_DayLabel" Grid.Row="0"
                           Text="{DynamicResource LOCGameActivityTimeTitle}"
                           Style="{DynamicResource SectionHeaderText}"
                           HorizontalAlignment="Center" />

                <lvc:CartesianChart x:Name="PART_ChartByDay" LegendLocation="None" Grid.Row="1"
                                    DisableAnimations="True" AnimationsSpeed="10"
                                    FontSize="{DynamicResource FontSize}" FontFamily="{DynamicResource CommonFont}">
                    <lvc:CartesianChart.DataTooltip>
                        <livechartscommon:CustomerToolTipForTime x:Name="PART_ChartByDay_ToolTip" />
                    </lvc:CartesianChart.DataTooltip>
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis x:Name="PART_ChartByDay_X" ShowLabels="True" LabelsRotation="30">
                            <lvc:Axis.Separator>
                                <lvc:Separator Step="1" />
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis x:Name="PART_ChartByDay_Y"
                                  FontSize="{DynamicResource FontSize}" FontFamily="{DynamicResource FontFamily}" />
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>

                <Label Grid.Row="2" FontSize="12" Content=" " />
            </Grid>
        </Border>

        <Border x:Name="PART_HoursByWeekCard" Grid.Row="2" Grid.Column="1" Style="{DynamicResource CardBorder}" Padding="8" Margin="10,0,0,0">
            <Grid x:Name="GridWeek">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="PART_WeekLabel" Grid.Row="0"
                           Text="{DynamicResource LOCGameActivityTotalHoursByWeeks}"
                           Style="{DynamicResource SectionHeaderText}"
                           HorizontalAlignment="Center" />

                <lvc:CartesianChart x:Name="PART_ChartByWeek" LegendLocation="None" Grid.Row="1"
                                    DisableAnimations="True" AnimationsSpeed="10"
                                    FontSize="{DynamicResource FontSize}" FontFamily="{DynamicResource CommonFont}">
                    <lvc:CartesianChart.DataTooltip>
                        <livechartscommon:CustomerToolTipForMultipleTime x:Name="PART_ChartByWeek_ToolTip" />
                    </lvc:CartesianChart.DataTooltip>
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis x:Name="PART_ChartByWeek_X" ShowLabels="True" FontSize="14" LabelsRotation="40">
                            <lvc:Axis.Separator>
                                <lvc:Separator Step="1" />
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis x:Name="PART_ChartByWeek_Y"
                                  FontSize="{DynamicResource FontSize}" FontFamily="{DynamicResource FontFamily}" />
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
            </Grid>
        </Border>
    </Grid>
</UserControl>
