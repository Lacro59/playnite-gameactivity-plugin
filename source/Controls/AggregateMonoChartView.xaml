<UserControl x:Class="GameActivity.Controls.AggregateMonoChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:livechartscommon="clr-namespace:CommonPluginsControls.LiveChartsCommon"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">

    <Border x:Name="PART_TotalHoursCard" Style="{DynamicResource CardBorder}" Padding="8" Margin="0">
        <Grid x:Name="PART_ChartGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PART_PieColumn" Width="0.45*" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="PART_Chart_Label"
                       Style="{DynamicResource SectionHeaderText}"
                       HorizontalAlignment="Center"
                       Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />

            <lvc:CartesianChart x:Name="PART_Chart" LegendLocation="None"
                                Grid.Row="1" Grid.Column="0"
                                DisableAnimations="True" AnimationsSpeed="10"
                                FontFamily="{DynamicResource CommonFont}">
                <lvc:CartesianChart.DataTooltip>
                    <livechartscommon:CustomerToolTipForTime x:Name="PART_Chart_ToolTip" />
                </lvc:CartesianChart.DataTooltip>
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis x:Name="PART_Chart_X" ShowLabels="True"
                              FontSize="{DynamicResource FontSize}" FontFamily="{DynamicResource CommonFont}">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="1" />
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis x:Name="PART_Chart_Y"
                              FontSize="{DynamicResource FontSize}" FontFamily="{DynamicResource FontFamily}" />
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>

            <lvc:PieChart x:Name="PART_ChartPie" LegendLocation="None"
                          Grid.Row="1" Grid.Column="1"
                          DisableAnimations="True" AnimationsSpeed="10"
                          Margin="8,0,0,0"
                          FontFamily="{DynamicResource CommonFont}"
                          Visibility="Collapsed">
                <lvc:PieChart.DataTooltip>
                    <livechartscommon:CustomerToolTipForTime x:Name="PART_ChartPie_ToolTip" />
                </lvc:PieChart.DataTooltip>
            </lvc:PieChart>
        </Grid>
    </Border>
</UserControl>
