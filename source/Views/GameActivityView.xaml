<UserControl x:Class="GameActivity.Views.GameActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:CommonPlayniteShared.Converters"
             xmlns:livechartscommon="clr-namespace:CommonPluginsControls.LiveChartsCommon"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:controlsShared="clr-namespace:CommonPluginsShared.Controls"
             xmlns:commonpluginscontrols="clr-namespace:CommonPluginsControls.Controls"
             xmlns:playnitecontrols="clr-namespace:CommonPluginsControls.PlayniteControls"
             xmlns:commonpluginsshared="clr-namespace:CommonPluginsShared.Converters"
             xmlns:Commonpluginsbehaviors="clr-namespace:CommonPluginsShared.Behaviors"
             xmlns:viewModels="clr-namespace:GameActivity.ViewModels" 
             xmlns:local="clr-namespace:GameActivity.Views"
             mc:Ignorable="d" d:DesignHeight="740" d:DesignWidth="1280"
             d:DataContext="{d:DesignInstance Type=viewModels:GameActivityViewModel}"
             Background="{DynamicResource WindowBackgourndBrush}">

    <UserControl.Resources>
        <converters:PlayTimeToStringConverter x:Key="PlayTimeToStringConverter" />
        <commonpluginsshared:DefaultIconConverter x:Key="DefaultIconConverter" />
        <commonpluginsshared:CompareValueConverter x:Key="CompareValueConverter" />
        <commonpluginsshared:LocalDateTimeConverter x:Key="LocalDateTimeConverter" />
        <commonpluginsshared:LocalDateRelativeConverter x:Key="LocalDateRelativeConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter" />

        <Style x:Key="NavTextToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource NavToggleButton}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="33" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontFamily" Value="{DynamicResource CommonFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="DatePickerIconOnly" TargetType="DatePicker" BasedOn="{StaticResource ModernDatePicker}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MaxWidth" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid Width="32" Height="32">
                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Visibility="Collapsed"
                                               Width="0"
                                               Height="0"
                                               IsHitTestVisible="False"
                                               Focusable="False" />

                            <Button x:Name="PART_Button" Margin="-5"
                                    Style="{DynamicResource NavIconButton}"
                                    Content="&#xEC45;"
                                    FontFamily="{DynamicResource FontIcoFont}"
                                    Width="32"
                                    Height="32"
                                    Focusable="False" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_Button}"
                                   StaysOpen="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <TabControl Margin="12">
        <TabItem Header="{DynamicResource LOCGameActivity}">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="250" MaxHeight="400" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Name="PART_DataLoad" Grid.RowSpan="3">
                    <ProgressBar IsIndeterminate="True" Width="350" Height="40" />
                    <TextBlock Text="{DynamicResource LOCLoadingLabel}"
                       Style="{DynamicResource BaseTextBlockStyle}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <Border Grid.Row="0" Name="PART_DataTop" Style="{DynamicResource SectionBorder}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Navigation -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>

                            <TabControl x:Name="PART_AggregateModeTabs"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        BorderThickness="0"
                                        Padding="0"
                                        Background="Transparent"
                                        SelectionChanged="AggregateModeTabs_SelectionChanged">
                                <TabItem Header="{DynamicResource LOCGameActivityAggregateGames}" />
                                <TabItem Header="{DynamicResource LOCSourcesLabel}" />
                                <TabItem Header="{DynamicResource LOCGenresLabel}" />
                                <TabItem Header="{DynamicResource LOCTagsLabel}" />
                            </TabControl>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="&#xe941;" Style="{DynamicResource NavCommonButton}" Click="Button_Click_PrevMonth"
                                        ToolTip="{DynamicResource LOCGameActivityPeriodPrevious}" />
                                <Label x:Name="activityLabel" Content="{Binding ActivityLabelText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" MinWidth="50" Margin="12,0" />
                                <Button Content="&#xe942;" Style="{DynamicResource NavCommonButton}" Click="Button_Click_NextMonth"
                                        ToolTip="{DynamicResource LOCGameActivityPeriodNext}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ComboBox x:Name="PART_PeriodPreset"
                                          MinWidth="140"
                                          Margin="0,0,8,0"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="PeriodPreset_SelectionChanged"
                                          ToolTip="{DynamicResource LOCGameActivityPeriodLengthTooltip}" />
                                <DatePicker VerticalAlignment="Center"
                                        Style="{StaticResource DatePickerIconOnly}"
                                        SelectedDateChanged="DatePicker_SelectedDateChanged"
                                        ToolTip="{DynamicResource LOCGameActivityPeriodSelectMonth}"
                                        Commonpluginsbehaviors:DatePickerCalendar.IsMonthYear="True">
                                <DatePicker.CalendarStyle>
                                    <Style TargetType="Calendar" BasedOn="{StaticResource {x:Type Calendar}}">
                                        <Setter Property="SnapsToDevicePixels" Value="True" />
                                        <Setter Property="CalendarDayButtonStyle" Value="{DynamicResource CalendarDayButtonStyle}"/>
                                        <Setter Property="CalendarButtonStyle" Value="{DynamicResource CalendarButtonStyle}"/>
                                        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type Calendar}">
                                                    <StackPanel HorizontalAlignment="Center" Name="PART_Root">
                                                        <CalendarItem Style="{DynamicResource CalendarItemStyle}" Name="PART_CalendarItem" />
                                                        <Button Content="{DynamicResource LOCToday}"
                                                                Command="Commonpluginsbehaviors:CalendarCommands.SelectToday"
                                                                CommandParameter="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DatePicker.CalendarStyle>
                            </DatePicker>
                            </StackPanel>
                        </Grid>

                        <!-- Graphics: mono hosts (Games/Genres/Tags) + Sources (lazy ContentControls) -->
                        <Grid Grid.Row="2">
                            <ContentControl x:Name="PART_AggregateGamesHost" />
                            <ContentControl x:Name="PART_AggregateGenresHost" Visibility="Collapsed" />
                            <ContentControl x:Name="PART_AggregateTagsHost" Visibility="Collapsed" />
                            <ContentControl x:Name="PART_AggregateSourcesHost" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Name="PART_DataBottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" MaxHeight="150" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{DynamicResource FilterCardBorder}" Margin="0,0,0,10">
                            <DockPanel LastChildFill="True">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Left"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,0,20,0">
                                        <TextBlock Text="{DynamicResource LOCSearchLabel}"
                                               Style="{DynamicResource BaseTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />

                                        <playnitecontrols:SearchBox x:Name="TextboxSearch"
                                                                Width="200"
                                                                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                TextChanged="TextboxSearch_TextChanged" />
                                    </StackPanel>

                                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                x:Name="FilterSourceButton"
                                                Content="{DynamicResource LOCSourceLabel}"
                                                Style="{DynamicResource SecondaryButton}"
                                                Padding="10,2"
                                                Margin="0"
                                                MinWidth="0"
                                                Click="FilterSourceButton_Click">
                                                <Button.ContextMenu>
                                                    <ContextMenu x:Name="FilterSourceMenu"
                                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                             Placement="Bottom"
                                                             MinWidth="180"
                                                             MaxHeight="320">
                                                        <ContextMenu.ItemsSource>
                                                            <Binding Path="FilterSourceItems" />
                                                        </ContextMenu.ItemsSource>
                                                        <ContextMenu.ItemContainerStyle>
                                                            <Style TargetType="{x:Type MenuItem}">
                                                                <Setter Property="Height" Value="30" />
                                                                <Setter Property="Padding" Value="6,2" />
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                                                <Setter Property="StaysOpenOnClick" Value="True" />
                                                                <Setter Property="IsCheckable" Value="False" />
                                                                <Setter Property="Tag" Value="{Binding}" />
                                                                <Setter Property="ToolTip" Value="{Binding SourceName}" />
                                                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FilterSourceMenuItem_PreviewMouseLeftButtonDown" />
                                                                <Setter Property="HeaderTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <CheckBox Name="PART_CbSource"
                                                                                  Tag="{Binding}"
                                                                                  IsChecked="{Binding IsCheck, Mode=TwoWay}"
                                                                                  Focusable="False"
                                                                                  BorderThickness="0"
                                                                                  Background="Transparent"
                                                                                  HorizontalAlignment="Stretch"
                                                                                  HorizontalContentAlignment="Left"
                                                                                  VerticalContentAlignment="Center"
                                                                                  Padding="0"
                                                                                  IsHitTestVisible="False"
                                                                                  Checked="PART_CbSource_Checked"
                                                                                  Unchecked="PART_CbSource_Unchecked">
                                                                                <commonpluginscontrols:TextBlockWithIcon Mode="IconTextFirstWithText"
                                                                                                                     Icon="{Binding ElementName=PART_CbSource, Path=Tag.SourceIcon}"
                                                                                                                     IconText="{Binding ElementName=PART_CbSource, Path=Tag.SourceIconText}"
                                                                                                                     LabelText="{Binding ElementName=PART_CbSource, Path=Tag.SourceName}" />
                                                                            </CheckBox>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ContextMenu.ItemContainerStyle>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>

                                            <DockPanel Grid.Column="2" LastChildFill="False" VerticalAlignment="Center">
                                                <Button Content="{DynamicResource LOCResetLabel}"
                                                    Style="{DynamicResource SecondaryButton}"
                                                    Margin="0"
                                                    Padding="8,2"
                                                    MinWidth="0"
                                                    Click="FilterSourceReset_Click" />

                                                <commonpluginscontrols:TextBlockTrimmed Style="{DynamicResource BaseTextBlockStyle}"
                                                                                    Margin="8,0,0,0"
                                                                                    VerticalAlignment="Center"
                                                                                    Text="{Binding FilterSourceText}" />
                                            </DockPanel>
                                        </Grid>
                                    </DockPanel>
                                </DockPanel>

                                <controlsShared:ListViewExtend x:Name="lvGames" Grid.Row="1"
                                                       Style="{StaticResource {x:Type ListView}}"
                                                       SelectionChanged="LvGames_SelectionChanged" FontSize="24"
                                                       SortingSortDirection="Descending"
                                                       ItemsSource="{Binding FilteredActivityList}"
                                                       SortingEnable="True" SortingDefaultDataName="TimePlayedInPeriod"
                                                       MinHeight="0"
                                                       VerticalAlignment="Stretch">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Width="70"
                                                        controlsShared:ListViewColumnOptions.DisableSorting="True">
                                                <GridViewColumnHeader Content="{DynamicResource LOCActionsLabel}" />
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button FontFamily="{DynamicResource CommonFont}" Content="&#xe90f;"
                                                            Tag="{Binding Id}" Click="Button_Click" HorizontalAlignment="Center"
                                                            ToolTip="{DynamicResource LOCGameActivityOpenGameDetails}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Width="50" x:Name="lvGamesIcon"
                                                        controlsShared:ListViewColumnOptions.DisableSorting="True">
                                                <GridViewColumnHeader Name="lvGamesIconHeader" Content="{DynamicResource LOCGameIconTitle}" />
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Image HorizontalAlignment="Center" Height="32" VerticalAlignment="Center" Width="32" 
                                                           Source="{Binding GameIcon, Converter={StaticResource DefaultIconConverter}}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Width="200"
                                                        controlsShared:ListViewColumnOptions.SortMemberPath="GameTitle">
                                                <GridViewColumnHeader Content="{DynamicResource LOCGameNameTitle}" />
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Visibility="{Binding GameExist, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Hyperlink Command="{Binding GoToGame}" CommandParameter="{Binding Id}">
                                                                <commonpluginscontrols:TextBlockTrimmed Text="{Binding GameTitle}" Style="{DynamicResource ListExtendStyleTextBlock}" />
                                                            </Hyperlink>
                                                            </TextBlock>
                                                            <TextBlock Visibility="{Binding GameExist, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                                            <commonpluginscontrols:TextBlockTrimmed Text="{Binding GameTitle}" Style="{DynamicResource ListExtendStyleTextBlock}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Width="150"
                                                    DisplayMemberBinding="{Binding TimePlayedInPeriod, Converter={StaticResource PlayTimeToStringConverter}}"
                                                    controlsShared:ListViewColumnOptions.SortMemberPath="TimePlayedInPeriod">
                                                <GridViewColumnHeader Content="{DynamicResource LOCGameActivityTimePlayedInPeriod}" />
                                            </GridViewColumn>

                                            <GridViewColumn Width="150"
                                                    controlsShared:ListViewColumnOptions.SortMemberPath="GameLastActivity">
                                                <GridViewColumnHeader Content="{DynamicResource LOCGameActivityLvGamesLastActivityInPeriod}" />
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding GameLastActivity, Converter={StaticResource LocalDateRelativeConverter}}"
                                                           ToolTip="{Binding GameLastActivity, Converter={StaticResource LocalDateTimeConverter}}"
                                                           Style="{DynamicResource ListExtendStyleTextBlock}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Width="130"
                                                        controlsShared:ListViewColumnOptions.SortMemberPath="GameElapsedSeconds">
                                                <GridViewColumnHeader Content="{DynamicResource LOCGameActivityLvGamesElapsedSeconds}" />
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Label Content="{Binding GameElapsedSeconds, Mode=OneWay, Converter={StaticResource PlayTimeToStringConverter}}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                                           Style="{DynamicResource ListExtendStyleLabel}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Width="75" x:Name="lvGamesSource"
                                                        controlsShared:ListViewColumnOptions.SortMemberPath="GameSourceName">
                                                <GridViewColumnHeader Content="{DynamicResource LOCSourceLabel}" Name="lvGamesSourceHeader" />
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Tag="{Binding}">
                                                            <commonpluginscontrols:TextBlockWithIcon Mode="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}, Path=Tag.TypeStoreIcon}" 
                                                                                                 Icon="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}, Path=Tag.SourceIcon}"
                                                                                                 IconText="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}, Path=Tag.SourceIconText}"
                                                                                                 Style="{DynamicResource ListExtendStyleTextBlock}"
                                                                                                 HorizontalAlignment="Center" VerticalAlignment="Stretch" FontSize="22" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Width="130" x:Name="lvGamesPcName"
                                                        controlsShared:ListViewColumnOptions.SortMemberPath="PCName">
                                                <GridViewColumnHeader Content="{DynamicResource LOCGameActivityPCName}" Name="lvGamesPcNameHeader" />
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Label Content="{Binding PCName}" VerticalAlignment="Stretch" Style="{DynamicResource ListExtendStyleLabel}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Width="130" x:Name="lvGamesPlayAction"
                                                        controlsShared:ListViewColumnOptions.SortMemberPath="GameActionName">
                                                <GridViewColumnHeader Content="{DynamicResource LOCIsPlayAction}" Name="lvGamesPlayActionHeader" />
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Label Content="{Binding GameActionName}" VerticalAlignment="Stretch" Style="{DynamicResource ListExtendStyleLabel}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn x:Name="lvAvgCpu">
                                                <GridViewColumnHeader Content="{DynamicResource LOCGameActivityAvgCpu}" Name="lvAvgCpuHeader" />
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Label Content="{Binding AvgCPU}" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                                            <Label.Style>
                                                                <Style TargetType="Label">
                                                                    <Setter Property="Foreground">
                                                                        <Setter.Value>
                                                                            <MultiBinding Converter="{StaticResource CompareValueConverter}" ConverterParameter="1">
                                                                                <Binding Path="AvgCPU" />
                                                                                <Binding Path="MaxCPU" />
                                                                                <Binding Path="EnableWarm" />
                                                                            </MultiBinding>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=IsSelected}"
                                                                     Value="True">
                                                                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=Foreground}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Label.Style>
                                                        </Label>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn x:Name="lvAvgGpu">
                                                <GridViewColumnHeader Content="{DynamicResource LOCGameActivityAvgGpu}" Name="lvAvgGpuHeader" />
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Label Content="{Binding AvgGPU}" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                                            <Label.Style>
                                                                <Style TargetType="Label">
                                                                    <Setter Property="Foreground">
                                                                        <Setter.Value>
                                                                            <MultiBinding Converter="{StaticResource CompareValueConverter}" ConverterParameter="1">
                                                                                <Binding Path="AvgGPU" />
                                                                                <Binding Path="MaxGPU" />
                                                                                <Binding Path="EnableWarm" />
                                                                            </MultiBinding>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=IsSelected}"
                                                                     Value="True">
                                                                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=Foreground}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Label.Style>
                                                        </Label>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn x:Name="lvAvgRam">
                                                <GridViewColumnHeader Content="{DynamicResource LOCGameActivityAvgRam}" Name="lvAvgRamHeader" />
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Label Content="{Binding AvgRAM}" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                                            <Label.Style>
                                                                <Style TargetType="Label">
                                                                    <Setter Property="Foreground">
                                                                        <Setter.Value>
                                                                            <MultiBinding Converter="{StaticResource CompareValueConverter}" ConverterParameter="1">
                                                                                <Binding Path="AvgRAM" />
                                                                                <Binding Path="MaxRAM" />
                                                                                <Binding Path="EnableWarm" />
                                                                            </MultiBinding>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=IsSelected}"
                                                                     Value="True">
                                                                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=Foreground}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Label.Style>
                                                        </Label>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn x:Name="lvAvgFps">
                                                <GridViewColumnHeader Content="{DynamicResource LOCGameActivityAvgFps}" Name="lvAvgFpsHeader" />
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Label Content="{Binding AvgFPS}" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                                            <Label.Style>
                                                                <Style TargetType="Label">
                                                                    <Setter Property="Foreground">
                                                                        <Setter.Value>
                                                                            <MultiBinding Converter="{StaticResource CompareValueConverter}" ConverterParameter="0">
                                                                                <Binding Path="AvgFPS" />
                                                                                <Binding Path="MinFPS" />
                                                                                <Binding Path="EnableWarm" />
                                                                            </MultiBinding>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=IsSelected}"
                                                                     Value="True">
                                                                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=Foreground}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Label.Style>
                                                        </Label>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn x:Name="lvAvgCpuT">
                                                <GridViewColumnHeader Content="{DynamicResource LOCGameActivityAvgCpuT}" Name="lvAvgCpuTHeader" />
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Label Content="{Binding AvgCPUT}" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                                            <Label.Style>
                                                                <Style TargetType="Label">
                                                                    <Setter Property="Foreground">
                                                                        <Setter.Value>
                                                                            <MultiBinding Converter="{StaticResource CompareValueConverter}" ConverterParameter="1">
                                                                                <Binding Path="AvgCPUT" />
                                                                                <Binding Path="MaxCPUT" />
                                                                                <Binding Path="EnableWarm" />
                                                                            </MultiBinding>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=IsSelected}"
                                                                     Value="True">
                                                                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=Foreground}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Label.Style>
                                                        </Label>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn x:Name="lvAvgGpuT">
                                                <GridViewColumnHeader Content="{DynamicResource LOCGameActivityAvgGpuT}" Name="lvAvgGpuTHeader" />
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Label Content="{Binding AvgGPUT}" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                                            <Label.Style>
                                                                <Style TargetType="Label">
                                                                    <Setter Property="Foreground">
                                                                        <Setter.Value>
                                                                            <MultiBinding Converter="{StaticResource CompareValueConverter}" ConverterParameter="1">
                                                                                <Binding Path="AvgGPUT" />
                                                                                <Binding Path="MaxGPUT" />
                                                                                <Binding Path="EnableWarm" />
                                                                            </MultiBinding>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=IsSelected}"
                                                                     Value="True">
                                                                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=Foreground}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Label.Style>
                                                        </Label>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn x:Name="lvAvgCpuP">
                                                <GridViewColumnHeader Content="{DynamicResource LOCGameActivityAvgCpuP}" Name="lvAvgCpuPHeader" />
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Label Content="{Binding AvgCPUP}" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                                            <Label.Style>
                                                                <Style TargetType="Label">
                                                                    <Setter Property="Foreground">
                                                                        <Setter.Value>
                                                                            <MultiBinding Converter="{StaticResource CompareValueConverter}" ConverterParameter="1">
                                                                                <Binding Path="AvgGPUT" />
                                                                                <Binding Path="MaxGPUT" />
                                                                                <Binding Path="EnableWarm" />
                                                                            </MultiBinding>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=IsSelected}"
                                                                     Value="True">
                                                                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=Foreground}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Label.Style>
                                                        </Label>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn x:Name="lvAvgGpuP">
                                                <GridViewColumnHeader Content="{DynamicResource LOCGameActivityAvgGpuP}" Name="lvAvgGpuPHeader" />
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Label Content="{Binding AvgGPUP}" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                                            <Label.Style>
                                                                <Style TargetType="Label">
                                                                    <Setter Property="Foreground">
                                                                        <Setter.Value>
                                                                            <MultiBinding Converter="{StaticResource CompareValueConverter}" ConverterParameter="1">
                                                                                <Binding Path="AvgGPUT" />
                                                                                <Binding Path="MaxGPUT" />
                                                                                <Binding Path="EnableWarm" />
                                                                            </MultiBinding>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=IsSelected}"
                                                                     Value="True">
                                                                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=Foreground}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Label.Style>
                                                        </Label>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </controlsShared:ListViewExtend>
                            </DockPanel>
                        </Border>

                        <DockPanel Grid.Row="2" LastChildFill="True" MinHeight="0">
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,4"
                                       Style="{DynamicResource SectionHeaderText}"
                                       Text="{DynamicResource LOCGameActivityPeriodSessions}" />
                            <controlsShared:ListViewExtend x:Name="lvSessions"
                                                           Style="{StaticResource {x:Type ListView}}"
                                                           SelectionChanged="LvSessions_SelectionChanged"
                                                           FontSize="{DynamicResource FontSize}"
                                                           SortingSortDirection="Descending"
                                                           SortingEnable="True"
                                                           SortingDefaultDataName="GameLastActivity"
                                                           ItemsSource="{Binding PeriodSessionList}"
                                                           MinHeight="0"
                                                           VerticalAlignment="Stretch">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="140"
                                                        controlsShared:ListViewColumnOptions.SortMemberPath="GameLastActivity">
                                            <GridViewColumnHeader Content="{DynamicResource LOCGameActivityLvGamesLastActivity}" />
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding GameLastActivity, Converter={StaticResource LocalDateRelativeConverter}}"
                                                               ToolTip="{Binding GameLastActivity, Converter={StaticResource LocalDateTimeConverter}}"
                                                               Style="{DynamicResource ListExtendStyleTextBlock}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="130"
                                                        controlsShared:ListViewColumnOptions.SortMemberPath="GameElapsedSeconds">
                                            <GridViewColumnHeader Content="{DynamicResource LOCGameActivityLvGamesElapsedSeconds}" />
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Label Content="{Binding GameElapsedSeconds, Mode=OneWay, Converter={StaticResource PlayTimeToStringConverter}}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                                           Style="{DynamicResource ListExtendStyleLabel}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="75"
                                                        controlsShared:ListViewColumnOptions.SortMemberPath="GameSourceName">
                                            <GridViewColumnHeader Content="{DynamicResource LOCSourceLabel}" />
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Tag="{Binding}">
                                                        <commonpluginscontrols:TextBlockWithIcon Mode="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}, Path=Tag.TypeStoreIcon}"
                                                                                                 Icon="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}, Path=Tag.SourceIcon}"
                                                                                                 IconText="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}, Path=Tag.SourceIconText}"
                                                                                                 Style="{DynamicResource ListExtendStyleTextBlock}"
                                                                                                 HorizontalAlignment="Center" VerticalAlignment="Stretch" FontSize="22" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="130"
                                                        controlsShared:ListViewColumnOptions.SortMemberPath="PCName">
                                            <GridViewColumnHeader Content="{DynamicResource LOCGameActivityPCName}" />
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Label Content="{Binding PCName}" VerticalAlignment="Stretch" Style="{DynamicResource ListExtendStyleLabel}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="130"
                                                        controlsShared:ListViewColumnOptions.SortMemberPath="GameActionName">
                                            <GridViewColumnHeader Content="{DynamicResource LOCIsPlayAction}" />
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Label Content="{Binding GameActionName}" VerticalAlignment="Stretch" Style="{DynamicResource ListExtendStyleLabel}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </controlsShared:ListViewExtend>
                        </DockPanel>
                    </Grid>

                    <Border Grid.Column="2" Grid.Row="0" Style="{DynamicResource SectionBorder}" Margin="0">
                        <DockPanel Name="activityForGamesGraphics" LastChildFill="True">
                            <!-- Header -->
                            <Grid DockPanel.Dock="Top" Height="45" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ToggleButton Grid.Column="2"
                                              x:Name="ToggleButtonTime"
                                              IsChecked="True"
                                              Content="{DynamicResource LOCGameActivityTime}"
                                              Style="{StaticResource NavTextToggleButton}"
                                              MinWidth="65" Margin="0,0,10,0"
                                              Click="ToggleButtonTime_Checked" />

                                <ToggleButton Grid.Column="3"
                                              x:Name="ToggleButtonLog"
                                              IsChecked="False"
                                              Content="{DynamicResource LOCGameActivityLog}"
                                              Style="{StaticResource NavTextToggleButton}"
                                              MinWidth="65"
                                              Click="ToggleButtonLog_Checked" />

                                <Label Grid.Column="0" Grid.ColumnSpan="5"
                                       x:Name="gameLabel"
                                       Content="graphics title"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="20"
                                       FontWeight="Bold" />

                            </Grid>

                            <!-- Bottom config -->
                            <Expander x:Name="PART_PcConfigExpander"
                                      DockPanel.Dock="Bottom"
                                      Margin="0,10,0,0"
                                      Style="{DynamicResource ModernExpanderStyle}"
                                      Header="{DynamicResource LOCMenuConfigurationTitle}"
                                      IsExpanded="False">
                                <Grid Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Style="{DynamicResource ViewColumnLabelText}"
                                               Text="{DynamicResource LOCGameActivityPCName}" />
                                    <Label Grid.Row="0"
                                           Grid.Column="2"
                                           Style="{DynamicResource ListExtendStyleLabel}"
                                           Name="PART_PcName" />

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="4"
                                               Style="{DynamicResource ViewColumnLabelText}"
                                               Text="OS" />
                                    <Label Grid.Row="0"
                                           Grid.Column="6"
                                           Style="{DynamicResource ListExtendStyleLabel}"
                                           Name="PART_Os" />

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Style="{DynamicResource ViewColumnLabelText}"
                                               Text="CPU" />
                                    <Label Grid.Row="2"
                                           Grid.Column="2"
                                           Grid.ColumnSpan="5"
                                           Style="{DynamicResource ListExtendStyleLabel}"
                                           Name="PART_CpuName" />

                                    <TextBlock Grid.Row="4"
                                               Grid.Column="0"
                                               Style="{DynamicResource ViewColumnLabelText}"
                                               Text="GPU" />
                                    <Label Grid.Row="4"
                                           Grid.Column="2"
                                           Style="{DynamicResource ListExtendStyleLabel}"
                                           Name="PART_GpuName" />

                                    <TextBlock Grid.Row="4"
                                               Grid.Column="4"
                                               Style="{DynamicResource ViewColumnLabelText}"
                                               Text="RAM" />
                                    <Label Grid.Row="4"
                                           Grid.Column="6"
                                           Style="{DynamicResource ListExtendStyleLabel}"
                                           Name="PART_Ram" />
                                </Grid>
                            </Expander>

                            <!-- Fill remaining space -->
                            <Grid Name="gameSeriesContener" Margin="0,10,0,0">
                                <Grid Name="PART_GameActivityChartTime_Contener"
                                      Visibility="{Binding ElementName=ToggleButtonTime, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <Grid Name="PART_GameActivityChartLog_Contener"
                                      Visibility="{Binding ElementName=ToggleButtonLog, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="{DynamicResource LOCGameActivityGanttView}" Name="PART">
            <local:GameActivityGanttView Margin="5" />
        </TabItem>
    </TabControl>
</UserControl>
