<UserControl x:Class="GameActivity.Views.GaMonitoringLoggingSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:GameActivity="clr-namespace:GameActivity"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance GameActivity:GameActivitySettingsViewModel}">
    <UserControl.Resources>
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource CompactCheckBox}" />
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <CheckBox x:Name="cbLogging" IsChecked="{Binding Settings.EnableLogging}">
                    <CheckBox.ToolTip>
                        <ToolTip Content="{DynamicResource LOCGameActivityEnableLoggingToolTip}" />
                    </CheckBox.ToolTip>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="{DynamicResource LOCGameActivityActiveLog}" Margin="0,0,5,0" />
                    </StackPanel>
                </CheckBox>
                <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Opacity="0.75"
                           Text="{DynamicResource LOCGameActivitySettingsLoggingProvidersNote}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="50,15,0,0"
                        IsEnabled="{Binding ElementName=cbLogging, Path=IsChecked, TargetNullValue=false}">
                <StackPanel Orientation="Horizontal">
                    <Label Content="{DynamicResource LOCGameActivityTimeInterval}" Height="23" Width="160" />
                    <TextBox HorizontalAlignment="Left" Height="23" Width="40"
                             Text="{Binding Settings.TimeIntervalLogging}"
                             PreviewTextInput="NumberValidationTextBox" MaxLength="3" />
                    <Label Content="{DynamicResource LOCGameActivityTimeLabel}" Height="23" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </ScrollViewer>
</UserControl>
