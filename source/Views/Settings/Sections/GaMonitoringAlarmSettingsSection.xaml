<UserControl x:Class="GameActivity.Views.GaMonitoringAlarmSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:GameActivity="clr-namespace:GameActivity"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance GameActivity:GameActivitySettingsViewModel}">
    <UserControl.Resources>
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource CompactCheckBox}" />
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <CheckBox x:Name="cbAlarm" IsChecked="{Binding Settings.EnableAlarm}">
                    <CheckBox.ToolTip>
                        <ToolTip Content="{DynamicResource LOCGameActivityEnableAlarmToolTip}" />
                    </CheckBox.ToolTip>
                    <Label Content="{DynamicResource LOCGameActivityActiveAlarm}" />
                </CheckBox>
                <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Opacity="0.75"
                           Text="{DynamicResource LOCGameActivitySettingsAlarmUsesThresholds}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="50,10,0,0"
                        IsEnabled="{Binding ElementName=cbAlarm, Path=IsChecked, TargetNullValue=false}">

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Content="{DynamicResource LOCGameActivityAlarmInterval}" Height="23" Width="160" />
                    <TextBox HorizontalAlignment="Left" Height="23" Width="40"
                             Text="{Binding Settings.TimeIntervalAlarm}"
                             PreviewTextInput="NumberValidationTextBox" MaxLength="3" />
                    <Label Content="{DynamicResource LOCGameActivityTimeLabel}" Height="23" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <CheckBox IsChecked="{Binding Settings.EnableAlarmToast}" Margin="0,0,20,0">
                        <Label Content="{DynamicResource LOCGameActivityAlarmEnableToast}" />
                    </CheckBox>
                    <CheckBox IsChecked="{Binding Settings.EnableAlarmSound}">
                        <Label Content="{DynamicResource LOCGameActivityAlarmEnableSound}" />
                    </CheckBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Content="{DynamicResource LOCGameActivityAlarmToastCorner}" Height="23" Width="160" />
                    <ComboBox Width="160" SelectedIndex="{Binding Settings.AlarmToastCorner}">
                        <ComboBoxItem Content="{DynamicResource LOCGameActivityAlarmToastCornerBottomRight}" />
                        <ComboBoxItem Content="{DynamicResource LOCGameActivityAlarmToastCornerBottomLeft}" />
                        <ComboBoxItem Content="{DynamicResource LOCGameActivityAlarmToastCornerTopRight}" />
                        <ComboBoxItem Content="{DynamicResource LOCGameActivityAlarmToastCornerTopLeft}" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Content="{DynamicResource LOCGameActivityAlarmToastDuration}" Height="23" Width="160" />
                    <TextBox HorizontalAlignment="Left" Height="23" Width="40"
                             Text="{Binding Settings.AlarmToastDurationSeconds}"
                             PreviewTextInput="NumberValidationTextBox" MaxLength="3" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Content="{DynamicResource LOCGameActivityAlarmToastOpacity}" Height="23" Width="160" />
                    <TextBox HorizontalAlignment="Left" Height="23" Width="40"
                             Text="{Binding Settings.AlarmToastOpacityPercent}"
                             PreviewTextInput="NumberValidationTextBox" MaxLength="3" />
                </StackPanel>

                <Button Content="{DynamicResource LOCGameActivityAlarmPreview}"
                        ToolTip="{DynamicResource LOCGameActivityAlarmPreviewToolTip}"
                        Command="{Binding PreviewAlarmCommand}"
                        MinHeight="26"
                        MinWidth="120"
                        HorizontalAlignment="Left"
                        Margin="0,5,0,0" />
            </StackPanel>
        </DockPanel>
    </ScrollViewer>
</UserControl>
