<UserControl x:Class="GameActivity.Views.GaIgnoreMismatchSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:GameActivity="clr-namespace:GameActivity"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance GameActivity:GameActivitySettingsViewModel}">
    <UserControl.Resources>
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource CompactCheckBox}" />
    </UserControl.Resources>

                <DockPanel Margin="0,20,0,0">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource LOCGameActivityIgnoreMismatchDescription}"/>

                        <Button Margin="0,10,0,0"
                                x:Name="PART_BtnIgnoreMismatchAddGame"
                                Content="{DynamicResource LOCGameActivityIgnoreMismatchAddGame}"
                                MinHeight="26"
                                HorizontalAlignment="Left"
                                Click="ButtonIgnoreMismatchAddGame_Click"/>
                    </StackPanel>

                    <ListBox x:Name="PART_IgnoreMismatchList"
                             Margin="0,10,0,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Height"
                                        Value="32"/>
                                <Setter Property="Padding"
                                        Value="4,0"/>
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Style="{DynamicResource ListBoxExtendStyleTextBlock}"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Button x:Name="PART_IgnoreMismatchRemoveButton"
                                            Grid.Column="1"
                                            Width="28"
                                            Height="28"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Opacity="0"
                                            IsHitTestVisible="False"
                                            Tag="{Binding}"
                                            ToolTip="{DynamicResource LOCGameActivityIgnoreMismatchRemoveTooltip}"
                                            ContentTemplate="{DynamicResource ClearTextIconTemplate}"
                                            Click="ButtonIgnoreMismatchRemoveItem_Click"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}"
                                                 Value="True">
                                        <Setter TargetName="PART_IgnoreMismatchRemoveButton"
                                                Property="Opacity"
                                                Value="1"/>
                                        <Setter TargetName="PART_IgnoreMismatchRemoveButton"
                                                Property="IsHitTestVisible"
                                                Value="True"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
</UserControl>
